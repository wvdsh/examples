{
  "ctjsVersion": "5.3.1",
  "notes": "/* Pong on Wavedash via ct.js. */",
  "language": "typescript",
  "libs": {
    "place": {
      "gridX": 1024,
      "gridY": 1024
    },
    "pointer": {},
    "keyboard": {},
    "keyboard.polyfill": {},
    "pointer.polyfill": {}
  },
  "actions": [],
  "scripts": [],
  "contentTypes": [],
  "globalVars": [],
  "startroom": "a0000000-0000-0000-0000-000000000001",
  "backups": 3,
  "assets": [
    {
      "type": "room",
      "uid": "a0000000-0000-0000-0000-000000000001",
      "name": "rm_main",
      "width": 960,
      "height": 540,
      "backgroundColor": "#060612",
      "backgrounds": [],
      "copies": [],
      "tiles": [],
      "gridX": 64,
      "gridY": 64,
      "diagonalGrid": false,
      "disableGrid": false,
      "simulate": true,
      "restrictCamera": false,
      "restrictMinX": 0,
      "restrictMinY": 0,
      "restrictMaxX": 960,
      "restrictMaxY": 540,
      "follow": -1,
      "isUi": false,
      "lastmod": 1747657200000,
      "behaviors": [],
      "extends": {},
      "extendTypes": "",
      "events": [
        {
          "eventKey": "OnRoomStart",
          "lib": "core",
          "arguments": {},
          "code": "const r = this as any;\nr.fieldW = 960;\nr.fieldH = 540;\nr.paddleW = 12;\nr.paddleH = 80;\nr.paddleMargin = 30;\nr.ballR = 8;\n\nr.playerY = r.fieldH / 2;\nr.cpuY = r.fieldH / 2;\nr.ballX = r.fieldW / 2;\nr.ballY = r.fieldH / 2;\nr.ballVx = 320;\nr.ballVy = 80;\nr.playerScore = 0;\nr.cpuScore = 0;\n\nr.gfx = new PIXI.Graphics();\nthis.addChild(r.gfx);\n\nr.label = new PIXI.Text('0  |  0', { fontFamily: 'monospace', fontSize: 36, fill: 0xffffff });\nr.label.anchor.set(0.5, 0);\nr.label.x = r.fieldW / 2;\nr.label.y = 24;\nthis.addChild(r.label);\n\nr.serveBall = (dir: number) => {\n  r.ballX = r.fieldW / 2;\n  r.ballY = r.fieldH / 2;\n  r.ballVx = 320 * dir;\n  r.ballVy = (Math.random() - 0.5) * 200;\n};\n\nif (typeof (window as any).Wavedash !== 'undefined') {\n  (window as any).Wavedash.updateLoadProgressZeroToOne(1);\n  (window as any).Wavedash.init({ debug: true });\n}"
        },
        {
          "eventKey": "OnStep",
          "lib": "core",
          "arguments": {},
          "code": "const r = this as any;\nconst dt = u.time;\n\nconst up = (inputs as any).registry['keyboard.KeyW'] || (inputs as any).registry['keyboard.ArrowUp'];\nconst down = (inputs as any).registry['keyboard.KeyS'] || (inputs as any).registry['keyboard.ArrowDown'];\nr.playerY += ((down ? 1 : 0) - (up ? 1 : 0)) * 480 * dt;\nr.playerY = Math.max(r.paddleH / 2, Math.min(r.fieldH - r.paddleH / 2, r.playerY));\n\nconst cpuTarget = r.ballVx > 0 ? r.ballY : r.fieldH / 2;\nconst cpuDelta = cpuTarget - r.cpuY;\nconst cpuStep = Math.sign(cpuDelta) * Math.min(Math.abs(cpuDelta), 260 * dt);\nr.cpuY += cpuStep;\nr.cpuY = Math.max(r.paddleH / 2, Math.min(r.fieldH - r.paddleH / 2, r.cpuY));\n\nr.ballX += r.ballVx * dt;\nr.ballY += r.ballVy * dt;\nif (r.ballY - r.ballR < 0) { r.ballY = r.ballR; r.ballVy = Math.abs(r.ballVy); }\nif (r.ballY + r.ballR > r.fieldH) { r.ballY = r.fieldH - r.ballR; r.ballVy = -Math.abs(r.ballVy); }\n\nconst playerRight = r.paddleMargin + r.paddleW;\nconst cpuLeft = r.fieldW - r.paddleMargin - r.paddleW;\nif (r.ballVx < 0 && r.ballX - r.ballR <= playerRight && Math.abs(r.ballY - r.playerY) <= r.paddleH / 2) {\n  r.ballX = playerRight + r.ballR;\n  r.ballVx = Math.abs(r.ballVx) * 1.05;\n}\nif (r.ballVx > 0 && r.ballX + r.ballR >= cpuLeft && Math.abs(r.ballY - r.cpuY) <= r.paddleH / 2) {\n  r.ballX = cpuLeft - r.ballR;\n  r.ballVx = -Math.abs(r.ballVx) * 1.05;\n}\n\nif (r.ballX < 0) { r.cpuScore += 1; r.serveBall(1); }\nelse if (r.ballX > r.fieldW) { r.playerScore += 1; r.serveBall(-1); }\n\nr.gfx.clear();\nfor (let y = 0; y < r.fieldH; y += 20) {\n  r.gfx.beginFill(0x333344);\n  r.gfx.drawRect(r.fieldW / 2 - 1, y, 2, 10);\n  r.gfx.endFill();\n}\nr.gfx.beginFill(0xffffff);\nr.gfx.drawRect(r.paddleMargin, r.playerY - r.paddleH / 2, r.paddleW, r.paddleH);\nr.gfx.drawRect(cpuLeft, r.cpuY - r.paddleH / 2, r.paddleW, r.paddleH);\nr.gfx.drawCircle(r.ballX, r.ballY, r.ballR);\nr.gfx.endFill();\n\nr.label.text = r.playerScore + '  |  ' + r.cpuScore;"
        }
      ]
    }
  ],
  "settings": {
    "authoring": {
      "author": "Wavedash",
      "site": "https://wavedash.com",
      "title": "Pong",
      "version": [1, 0, 0],
      "versionPostfix": "",
      "appId": "gg.wavedash.example.ctjs.pong"
    },
    "rendering": {
      "usePixiLegacy": true,
      "transparent": false,
      "maxFPS": 60,
      "pixelatedrender": false,
      "highDensity": true,
      "desktopMode": "maximized",
      "hideCursor": false,
      "mobileScreenOrientation": "unspecified",
      "viewMode": "scaleFit"
    },
    "export": {
      "showErrors": true,
      "errorsLink": "",
      "autocloseDesktop": true,
      "windows": true,
      "linux": true,
      "mac": true,
      "functionWrap": false,
      "codeModifier": "none",
      "bundleAssetTree": false,
      "bundleAssetTypes": {
        "texture": true,
        "template": true,
        "room": true,
        "behavior": false,
        "typeface": false,
        "sound": false,
        "style": false,
        "tandem": false,
        "script": false,
        "enum": false
      }
    },
    "branding": {
      "accent": "#fa1e4e",
      "invertPreloaderScheme": true,
      "icon": -1,
      "splashScreen": -1,
      "forceSmoothIcons": false,
      "forceSmoothSplashScreen": false,
      "hideLoadingLogo": false,
      "alternativeLogo": false,
      "customLoadingText": ""
    }
  }
}
