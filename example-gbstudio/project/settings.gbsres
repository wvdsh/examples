  "collisionLayerOpacity": 50,
  "sgbEnabled": false,
  "customHead": "<script type=\"module\">\n  // Stream binjgb.wasm + the GB rom through the SDK loading bar.\n  let _wdSdk = null;\n  _wdSdk = window.Wavedash;\n\n  const KNOWN = [\"binjgb.wasm\", \".gb\"];\n  const totals = {};\n  const received = {};\n  const realFetch = window.fetch.bind(window);\n  window.fetch = async (input, init) => {\n    const url = typeof input === \"string\" ? input : (input && input.url) || \"\";\n    const matched = KNOWN.find((k) => url.endsWith(k));\n    const response = await realFetch(input, init);\n    if (!matched || !response.body) return response;\n    const total = +response.headers.get(\"Content-Length\") || 0;\n    if (!total) return response;\n    totals[matched] = total;\n    received[matched] = 0;\n    const reader = response.body.getReader();\n    const stream = new ReadableStream({\n      async pull(controller) {\n        const { done, value } = await reader.read();\n        if (done) { controller.close(); return; }\n        received[matched] += value.length;\n        const totalAll = Object.values(totals).reduce((a, b) => a + b, 0);\n        const recvAll = Object.values(received).reduce((a, b) => a + b, 0);\n        if (_wdSdk && totalAll) _wdSdk.updateLoadProgressZeroToOne(Math.min(0.95, recvAll / totalAll));\n        controller.enqueue(value);\n      },\n      cancel(reason) { return reader.cancel(reason); },\n    });\n    return new Response(stream, {\n      status: response.status,\n      statusText: response.statusText,\n      headers: response.headers,\n    });\n  };\n\n  // Settle the bar at 1.0 once binjgb has had time to fetch both files.\n  setTimeout(() => {\n    try {\n      window.Wavedash.updateLoadProgressZeroToOne(1.0);\n      window.Wavedash.init({ debug: true });\n    } catch (e) { console.warn(\"[wavedash] init failed:\", e); }\n  }, 400);\n</script>",
